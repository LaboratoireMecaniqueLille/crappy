digraph image_pipeline_architectures {
  graph [
    rankdir=TB,
    bgcolor="#FFFFFF",
    pad="0.10",
    nodesep="0.30",
    ranksep="0.42",
    splines=ortho,
    newrank=true,
    outputorder=edgesfirst,
    fontname="Helvetica",
    fontcolor="#24313F",
    compound=true
  ];

  node [
    shape=box,
    style=filled,
    fillcolor="#F5F8FC",
    color="#557896",
    penwidth=1.25,
    fontname="Helvetica",
    fontsize=11,
    fontcolor="#1F2B37",
    margin="0.17,0.10"
  ];

  edge [
    fontname="Helvetica",
    fontsize=8.6,
    color="#000000",
    fontcolor="#64717E",
    penwidth=1.10,
    arrowsize=0.66
  ];


  /* ============================================================
     LEFT: COMPOSABLE VISIONBLOCK PIPELINE
     ============================================================ */

  subgraph cluster_vision {
    label="Composable pipeline: several public VisionBlocks in the script graph";
    labelloc=t;
    labeljust=l;
    fontsize=10.8;
    fontname="Helvetica";
    fontcolor="#24313F";
    color="#C7CFD8";
    penwidth=1.0;
    style="rounded,filled";
    fillcolor="#FBFCFE";
    margin=10;

    vision_top [
      label="",
      shape=point,
      width=0,
      height=0,
      style=invis
    ];


    subgraph cluster_camera_source {
      label="CameraSource VisionBlock";
      labelloc=t;
      labeljust=l;
      fontsize=10.2;
      fontname="Helvetica";
      fontcolor="#24313F";
      color="#D3DAE2";
      penwidth=1.0;
      style="rounded,filled";
      fillcolor="#FFFFFF";
      margin=12;

      camera_object_v [
        label="Camera object\nhardware integration",
        shape=ellipse,
        style=filled,
        fillcolor="#F7F8FA",
        color="#9AA4AE",
        penwidth=1.0
      ];

      source_output [
        label="Acquisition and\nimage output",
        shape=box,
        style=filled,
        fillcolor="#F5F8FC",
        color="#557896",
        penwidth=1.25
      ];

      camera_object_v -> source_output [
        label="  device API",
        style=dashed,
        color="#000000",
        fontcolor="#7A858F",
        penwidth=0.95,
        arrowsize=0.62
      ];
    }


    processor [
      label="Processor\nVisionBlock",
      shape=box,
      style="rounded,filled",
      fillcolor="#FBFCFE",
      color="#000000",
      penwidth=1.25
    ];

    display [
      label="ImageDisplayer\nVisionBlock",
      shape=box,
      style="rounded,filled",
      fillcolor="#FBFCFE",
      color="#000000",
      penwidth=1.25
    ];

    recorder [
      label="ImageRecorder\nVisionBlock",
      shape=box,
      style="rounded,filled",
      fillcolor="#FBFCFE",
      color="#000000",
      penwidth=1.25
    ];


    vision_top -> camera_object_v [
      style=invis,
      weight=100
    ];

    source_output -> processor [
      taillabel="\nImageLink   "
    ];

    processor -> display [
      label="   ImageLink"
    ];

    source_output -> recorder [
      taillabel="\n    ImageLink"
    ];
  }



  /* ============================================================
     RIGHT: ALL-IN-ONE CAMERA BLOCK
     ============================================================ */

  subgraph cluster_camera_block {
    label="All-in-one Camera Block: one public Block in the script graph";
    labelloc=t;
    labeljust=l;
    fontsize=10.8;
    fontname="Helvetica";
    fontcolor="#24313F";
    color="#C7CFD8";
    penwidth=1.0;
    style="rounded,filled";
    fillcolor="#FBFCFE";
    margin=10;

    camera_block_top [
      label="",
      shape=point,
      width=0,
      height=0,
      style=invis
    ];


    camera_object_a [
      label="Camera object\nhardware integration",
      shape=ellipse,
      style=filled,
      fillcolor="#F7F8FA",
      color="#9AA4AE",
      penwidth=1.0
    ];

    acquisition [
      label="Acquisition and\nlatest-frame publication",
      shape=box,
      style=filled,
      fillcolor="#F5F8FC",
      color="#557896",
      penwidth=1.25
    ];

    internal_process [
      label="Internal CameraProcess\noptional image processing",
      shape=box,
      style=filled,
      fillcolor="#F5F8FC",
      color="#557896",
      penwidth=1.25
    ];

    internal_display [
      label="Internal display worker",
      shape=box,
      style=filled,
      fillcolor="#F5F8FC",
      color="#557896",
      penwidth=1.25
    ];

    internal_record [
      label="Internal recording worker",
      shape=box,
      style=filled,
      fillcolor="#F5F8FC",
      color="#557896",
      penwidth=1.25
    ];


    camera_block_top -> camera_object_a [
      style=invis,
      weight=100
    ];

    camera_object_a -> acquisition [
      label="  device API",
      style=dashed,
      color="#000000",
      fontcolor="#7A858F",
      penwidth=0.95,
      arrowsize=0.62
    ];

    acquisition -> internal_process [
      taillabel="shared latest frame     \n\n"
    ];

    acquisition -> internal_display [
      label="    shared latest frame"
    ];

    acquisition -> internal_record [
      taillabel="     shared latest frame\n\n"
    ];
  }


  /* Align the TOP of the two outer clusters */
  {
    rank=same;
    vision_top;
    camera_block_top;
  }
}